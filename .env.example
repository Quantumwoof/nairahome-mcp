# All optional.
PORT=8787
HOST=127.0.0.1
# live (default) | demo  -> demo uses clearly labelled fixture rates for offline work
FX_MODE=live
# file (default locally) | memory | blob (Vercel Blob; also auto-selected when BLOB_READ_WRITE_TOKEN is set)
STORE=file
DATA_DIR=./data
# Require "Authorization: Bearer <token>" on /mcp (recommended when self-hosting publicly)
NAIRAHOME_TOKEN=
# Comma-separated Origin allow-list for browser clients (DNS-rebinding protection)
ALLOWED_ORIGINS=
